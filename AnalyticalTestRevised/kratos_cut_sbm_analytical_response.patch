+         ));
+         rD(1,0) = ((sig_y >= (1.0/2.0)*E*std::sqrt(4*std::pow(eps_xx, 2) - 4*eps_xx*eps_yy + 4*std::pow(eps_yy, 2) + 3*std::pow(gamma_xy, 2))/(nu + 1)) ? (
