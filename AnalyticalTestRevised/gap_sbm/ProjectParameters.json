// gap_sbm; campo=linear; materiale=elastic
// Campo lineare nello spazio: u=(x*t,0). Patch test; forza di volume nulla.
// Materiale distinto dal campo: "linear" indica u(x), non la legge costitutiva.
// Dominio fisico [0,4] x [0,2]. Dirichlet esatto su TUTTO il contorno.
// BODY_FORCE=-div(sigma), densita=1; stessi campi per bulk e GapElements.
// plastic: J2 perfettamente plastico, E=67000, nu=0, sigma_y=201; t>=0 monotono.
// elastic: plane strain lineare, E=67000, nu=0; nessuno snervamento.
// Per cambiare campo/materiale scegliere un altro file completo; non decommentare formule isolate.
{
  "problem_data": {
    "problem_name": "gap_sbm_linear_elastic",
    "echo_level": 0,
    "parallel_type": "OpenMP",
    "start_time": 0.0,
    "end_time": 0.002
  },
  "solver_settings": {
    "model_part_name": "IgaModelPart",
    "domain_size": 2,
    "echo_level": 0,
    "buffer_size": 2,
    "analysis_type": "non_linear",
    "model_import_settings": {
      "input_type": "use_input_model_part"
    },
    "material_import_settings": {
      "materials_filename": "../materials_elastic.json"
    },
    "time_stepping": {
      "time_step": 0.0002
    },
    "rotation_dofs": false,
    "reform_dofs_at_each_step": false,
    "compute_reactions": false,
    "clear_storage": false,
