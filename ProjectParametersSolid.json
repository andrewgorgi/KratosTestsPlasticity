                    "value"           : ["-cos(x)*sinh(y)","sin(x)*cosh(y)", "0.0"]
                }]
            },
            {
              "iga_model_part": "SBM_Support_outer_SIMMETRY",
              "variables": [
                {
                    "assign_by_direction": true,
                    "direction": ["0.2","0.8", "0.0"],
                    "variable_name": "DISPLACEMENT",
                    "modulus": "-cos(x)*sinh(y)*0.2 + sin(x)*cosh(y)*0.8"
                }
              ]
