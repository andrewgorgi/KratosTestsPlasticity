                    //                      "(67000*pi**2*t*sin((1/4)*pi*x)*cos((1/2)*pi*y)) if (sqrt(21)*pi*abs(t*sin((1/4)*pi*x)*sin((1/2)*pi*y))) <= 3/500 else (16750*pi**2*t*sin((1/4)*pi*x)*cos((1/2)*pi*y))",
